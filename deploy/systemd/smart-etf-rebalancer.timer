[Unit]
Description=Run Smart ETF Rebalancer on the first day of each month

[Timer]
# The first scheduled run is intentionally dry-run only. Change this schedule
# after verifying the desired exchange-session timing for the account.
OnCalendar=*-*-01 10:30:00 Asia/Seoul
Persistent=true
Unit=smart-etf-rebalancer.service

[Install]
WantedBy=timers.target
