# 토스증권 WTS > 설정 > Open API에서 발급. 실제 값을 저장소에 넣지 마세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 여러 계좌가 있는 경우에만 명시하세요. 비어 있으면 첫 BROKERAGE 계좌를 사용합니다.
TOSS_ACCOUNT_SEQ=

# 안전 기본값: 주문을 절대 전송하지 않습니다.
DRY_RUN=true

# 월 적립금 및 주문 안전 여유
MONTHLY_BUDGET_KRW=500000
CASH_BUFFER_RATE=0.02
MIN_ORDER_USD=1.00
REBALANCE_THRESHOLD=0.05

# TQQQ 최근 고점 산정 거래일 수
DRAWDOWN_LOOKBACK_DAYS=252
